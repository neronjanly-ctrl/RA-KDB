<div class="mt-4">
    <button type="button"
            class="btn btn-outline-primary"
            id="download-summary-csv"
            data-url="@summaryReportUrl">
        Download Analytics Summary CSV <i class="fa fa-download"></i>
    </button>

    <button type="button"
            class="btn btn-outline-primary"
            id="download-full-csv"
            data-url="@fullReportUrl">
        Download Full Analysis CSV <i class="fa fa-download"></i>
    </button>
</div>

@section Menu {
    @{
        ViewData["ActiveMenu"] = "docking";
        ViewData["JobNavDomainId"] = Model.DomainId;
        ViewData["JobNavJobId"] = Model.Summary.Job.Id;
        ViewData["JobNavActive"] = "analytics";
    }
    <partial name="_RaWorkspaceMenu" />
    <partial name="_RaJobContextMenu" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        window.jobAnalyticsPayload = @Html.Raw(JsonSerializer.Serialize(Model.FrontendPayload));

        (function () {
            const payload = window.jobAnalyticsPayload || {};
            console.log("Analytics payload", payload);

            const fig = payload.Figures || payload.figures || {};
            if (!window.Chart) return;

            const to2 = v => (typeof v === "number" ? v.toFixed(2) : "N/A");
            const get = (obj, pascal, camel) => obj?.[pascal] ?? obj?.[camel];

            const priorityClassToGroup = (point) => {
                const c = (point.CandidateClass ?? point.candidateClass ?? "").toLowerCase();
                if (c.includes("high priority")) return "high-priority";
                if (c.includes("known-like strong")) return "known-like-strong";
                if (c.includes("novel strong binder")) return "novel-strong-binder";
                if (c.includes("moderate")) return "moderate";
                return "low-priority";
            };

            const groupColor = {
                "high-priority": "#dc2626",
                "known-like-strong": "#7c3aed",
                "novel-strong-binder": "#0f766e",
                "moderate": "#f59e0b",
                "low-priority": "#2563eb"
            };

            const pluginId = "analytics-threshold-lines";
            const thresholdLinePlugin = {
                id: pluginId,
                afterDatasetsDraw(chart, args, pluginOptions) {
                    const lines = pluginOptions?.lines || [];
                    const min = pluginOptions?.min;
                    const max = pluginOptions?.max;
                    if (!lines.length || typeof min !== "number" || typeof max !== "number" || min === max) return;

                    const { left, right, top, bottom } = chart.chartArea || {};
                    if (left === undefined) return;

                    const ctx = chart.ctx;
                    lines.forEach((line) => {
                        if (typeof line.value !== "number") return;
                        const ratio = (line.value - min) / (max - min);
                        const x = left + ratio * (right - left);
                        if (x < left || x > right) return;

                        ctx.save();
                        ctx.strokeStyle = line.color || "#111";
                        ctx.lineWidth = 1.5;
                        ctx.setLineDash([6, 4]);
                        ctx.beginPath();
                        ctx.moveTo(x, top);
                        ctx.lineTo(x, bottom);
                        ctx.stroke();
                        ctx.setLineDash([]);
                        ctx.fillStyle = line.color || "#111";
                        ctx.font = "11px sans-serif";
                        if (line.label) ctx.fillText(line.label, x + 4, top + 12);
                        ctx.restore();
                    });
                }
            };
            Chart.register(thresholdLinePlugin);

            const scatterThresholdPlugin = {
                id: "analytics-scatter-threshold-lines",
                afterDatasetsDraw(chart, args, pluginOptions) {
                    const lines = pluginOptions?.lines || [];
                    if (!lines.length) return;

                    const xScale = chart.scales?.x;
                    const yScale = chart.scales?.y;
                    if (!xScale || !yScale) return;

                    const ctx = chart.ctx;
                    lines.forEach((line) => {
                        if (typeof line.value !== "number") return;

                        ctx.save();
                        ctx.strokeStyle = line.color || "#111";
                        ctx.lineWidth = 1.5;
                        ctx.setLineDash([6, 4]);

                        if ((line.axis || "").toLowerCase() === "y") {
                            const y = yScale.getPixelForValue(line.value);
                            ctx.beginPath();
                            ctx.moveTo(xScale.left, y);
                            ctx.lineTo(xScale.right, y);
                            ctx.stroke();
                            if (line.label) {
                                ctx.fillStyle = line.color || "#111";
                                ctx.font = "11px sans-serif";
                                ctx.fillText(line.label, xScale.left + 4, y - 4);
                            }
                        } else {
                            const x = xScale.getPixelForValue(line.value);
                            ctx.beginPath();
                            ctx.moveTo(x, yScale.top);
                            ctx.lineTo(x, yScale.bottom);
                            ctx.stroke();
                            if (line.label) {
                                ctx.fillStyle = line.color || "#111";
                                ctx.font = "11px sans-serif";
                                ctx.fillText(line.label, x + 4, yScale.top + 12);
                            }
                        }

                        ctx.restore();
                    });
                }
            };
            Chart.register(scatterThresholdPlugin);

            const buildHistogramOptions = (histogram) => {
                const xAxisTitle = get(histogram, "XAxisTitle", "xAxisTitle");
                const yAxisTitle = get(histogram, "YAxisTitle", "yAxisTitle");
                return {
                    scales: {
                        x: { title: { display: !!xAxisTitle, text: xAxisTitle || "" } },
                        y: { title: { display: !!yAxisTitle, text: yAxisTitle || "" } }
                    },
                    plugins: {
                        [pluginId]: {
                            lines: get(histogram, "ThresholdLines", "thresholdLines") || [],
                            min: get(histogram, "Min", "min"),
                            max: get(histogram, "Max", "max")
                        }
                    }
                };
            };

            const dockingFigure = get(fig, "DockingDistribution", "dockingDistribution") || {};
            const dockingCanvas = document.getElementById("chart-docking");
            if (dockingCanvas) {
                new Chart(dockingCanvas, {
                    type: "bar",
                    data: {
                        labels: get(dockingFigure, "Labels", "labels") || [],
                        datasets: [{
                            label: "Count",
                            data: get(dockingFigure, "Counts", "counts") || [],
                            backgroundColor: "#4e79a7"
                        }]
                    },
                    options: buildHistogramOptions(dockingFigure)
                });
            }

            const similarityFigure = get(fig, "SimilarityDistribution", "similarityDistribution") || {};
            const similarityCanvas = document.getElementById("chart-similarity");
            if (similarityCanvas) {
                new Chart(similarityCanvas, {
                    type: "bar",
                    data: {
                        labels: get(similarityFigure, "Labels", "labels") || [],
                        datasets: [{
                            label: "Count",
                            data: get(similarityFigure, "Counts", "counts") || [],
                            backgroundColor: "#59a14f"
                        }]
                    },
                    options: buildHistogramOptions(similarityFigure)
                });
            }

            const topBarFigure = get(fig, "TopCandidatesBar", "topCandidatesBar") || {};
            const topBarCanvas = document.getElementById("chart-top-bar");
            if (topBarCanvas) {
                new Chart(topBarCanvas, {
                    type: "bar",
                    data: {
                        labels: get(topBarFigure, "Labels", "labels") || [],
                        datasets: [{
                            label: "Priority Score",
                            data: get(topBarFigure, "PriorityScores", "priorityScores") || [],
                            backgroundColor: "#9c755f"
                        }]
                    },
                    options: { indexAxis: "y" }
                });
            }

            const boxFigure = get(fig, "ModelBoxplot", "modelBoxplot") || {};
            const box = get(boxFigure, "Models", "models") || [];
            const boxCanvas = document.getElementById("chart-boxplot");
            if (boxCanvas) {
                new Chart(boxCanvas, {
                    type: "bar",
                    data: {
                        labels: box.map(o => o.Model ?? o.model),
                        datasets: [
                            { label: "Q1", data: box.map(o => o.Q1 ?? o.q1), backgroundColor: "#e0ecf8", stack: "s" },
                            { label: "IQR", data: box.map(o => (o.Q3 ?? o.q3) - (o.Q1 ?? o.q1)), backgroundColor: "#4e79a7", stack: "s" }
                        ]
                    },
                    options: {
                        plugins: {
                            tooltip: {
                                callbacks: {
                                    afterBody: (ctx) => {
                                        const i = ctx[0].dataIndex;
                                        const b = box[i];
                                        return [
                                            `min ${to2(b.Min ?? b.min)}`,
                                            `median ${to2(b.Median ?? b.median)}`,
                                            `max ${to2(b.Max ?? b.max)}`
                                        ];
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const scatterFigure = get(fig, "PriorityScatter", "priorityScatter") || {};
            const scatterThresholds = get(scatterFigure, "ThresholdLines", "thresholdLines") || [];
            const priorityPoints = get(scatterFigure, "Points", "points") || [];

            const groupedPoints = priorityPoints.reduce((acc, p) => {
                const key = priorityClassToGroup(p);
                if (!acc[key]) acc[key] = [];
                acc[key].push(p);
                return acc;
            }, {});

            const scatterCanvas = document.getElementById("chart-priority-scatter");
            if (scatterCanvas) {
                new Chart(scatterCanvas, {
                    type: "bubble",
                    data: {
                        datasets: Object.entries(groupedPoints).map(([groupName, points]) => ({
                            label: groupName,
                            data: points.map((p) => ({
                                x: p.X ?? p.x,
                                y: p.Y ?? p.y,
                                r: Math.max(3, Math.sqrt(((p.Size ?? p.size) || 1) / 2)),
                                rawPoint: p
                            })),
                            backgroundColor: groupColor[groupName] || "#6b7280",
                            borderColor: (ctx) => {
                                const rp = ctx.raw?.rawPoint || {};
                                const isTop = rp.IsTopCandidate ?? rp.isTopCandidate;
                                return isTop ? "#111111" : "#374151";
                            },
                            borderWidth: (ctx) => {
                                const rp = ctx.raw?.rawPoint || {};
                                const isTop = rp.IsTopCandidate ?? rp.isTopCandidate;
                                return isTop ? 2.2 : 1;
                            }
                        }))
                    },
                    options: {
                        scales: {
                            x: { title: { display: true, text: "Docking Mean" } },
                            y: { min: 0, max: 1, title: { display: true, text: "Similarity" } }
                        },
                        plugins: {
                            "analytics-scatter-threshold-lines": { lines: scatterThresholds },
                            tooltip: {
                                callbacks: {
                                    title: (items) => {
                                        const rawPoint = items?.[0]?.raw?.rawPoint || {};
                                        return rawPoint.Protein || rawPoint.protein || rawPoint.Label || rawPoint.label || "Candidate";
                                    },
                                    label: (ctx) => {
                                        const rawPoint = ctx.raw?.rawPoint || {};
                                        return [
                                            `protein: ${rawPoint.Protein || rawPoint.protein || rawPoint.Label || rawPoint.label || "N/A"}`,
                                            `docking: ${to2(rawPoint.Docking ?? rawPoint.docking ?? rawPoint.X ?? rawPoint.x)}`,
                                            `similarity: ${to2(rawPoint.Similarity ?? rawPoint.similarity ?? rawPoint.Y ?? rawPoint.y)}`,
                                            `priority: ${to2(rawPoint.Priority ?? rawPoint.priority)}`,
                                            `class: ${priorityClassToGroup(rawPoint)}`
                                        ];
                                    }
                                }
                            }
                        }
                    }
                });
            }

            const heatmapEl = document.getElementById("chart-heatmap");
            const heatmap = get(fig, "ModelCorrelationHeatmap", "modelCorrelationHeatmap") || {};
            const labels = get(heatmap, "Labels", "labels") || [];
            const matrix = get(heatmap, "Matrix", "matrix") || [];

            if (heatmapEl) {
                let html = "<table class='table table-sm table-bordered mb-0'><thead><tr><th></th>" + labels.map(l => `<th>${l}</th>`).join("") + "</tr></thead><tbody>";
                for (let i = 0; i < labels.length; i++) {
                    html += `<tr><th>${labels[i]}</th>`;
                    for (let j = 0; j < labels.length; j++) {
                        const v = (matrix[i] || [])[j] ?? 0;
                        const red = v > 0 ? Math.round(255 * v) : 0;
                        const blue = v < 0 ? Math.round(255 * -v) : 0;
                        html += `<td style="background-color:rgba(${red},80,${blue},0.28)">${to2(v)}</td>`;
                    }
                    html += "</tr>";
                }
                heatmapEl.innerHTML = html + "</tbody></table>";
            }

            async function downloadCsv(url, fallbackFileName) {
                const response = await fetch(url, {
                    method: "GET",
                    credentials: "same-origin"
                });

                if (!response.ok) {
                    throw new Error(`Download failed: ${response.status}`);
                }

                const blob = await response.blob();
                const contentDisposition = response.headers.get("Content-Disposition") || "";
                const match = contentDisposition.match(/filename="?([^"]+)"?/i);
                const fileName = match?.[1] || fallbackFileName || "analytics.csv";

                const blobUrl = window.URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = blobUrl;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(blobUrl);
            }

            const summaryBtn = document.getElementById("download-summary-csv");
            if (summaryBtn) {
                summaryBtn.addEventListener("click", async function () {
                    const url = this.dataset.url;
                    try {
                        this.disabled = true;
                        await downloadCsv(url, "analytics-summary.csv");
                    } catch (err) {
                        console.error(err);
                        alert("Failed to download Analytics Summary CSV.");
                    } finally {
                        this.disabled = false;
                    }
                });
            }

            const fullBtn = document.getElementById("download-full-csv");
            if (fullBtn) {
                fullBtn.addEventListener("click", async function () {
                    const url = this.dataset.url;
                    try {
                        this.disabled = true;
                        await downloadCsv(url, "analytics-full.csv");
                    } catch (err) {
                        console.error(err);
                        alert("Failed to download Full Analysis CSV.");
                    } finally {
                        this.disabled = false;
                    }
                });
            }
        })();
    </script>
}