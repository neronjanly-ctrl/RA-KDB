@using System.Globalization
@using System.Collections.Generic
@using System.Text.Json
@model GenericComputationPlatform.ViewModels.Analytics.JobAnalyticsPageModel
@{
    ViewData["Title"] = $"{Model.Summary.Job.Name} #{Model.Summary.Job.Id} Analytics";
    var cfg = Model.Summary.AppliedConfig;
    var routeConfig = new Dictionary<string, string>
            {
                ["platformDefaults.dockingThreshold"] = cfg.PlatformDefaults.DockingThreshold.ToString(CultureInfo.InvariantCulture),
                ["platformDefaults.similarityThresholdInteraction"] = cfg.PlatformDefaults.SimilarityThresholdInteraction.ToString(CultureInfo.InvariantCulture),
                ["platformDefaults.similarityThresholdKnown"] = cfg.PlatformDefaults.SimilarityThresholdKnown.ToString(CultureInfo.InvariantCulture),
                ["analysisParams.topN"] = cfg.AnalysisParams.TopN.ToString(CultureInfo.InvariantCulture),
                ["analysisParams.aggregateMethod"] = cfg.AnalysisParams.AggregateMethod,
                ["analysisParams.highPriorityStdThreshold"] = cfg.AnalysisParams.HighPriorityStdThreshold.ToString(CultureInfo.InvariantCulture),
                ["analysisParams.moderateDockingThreshold"] = cfg.AnalysisParams.ModerateDockingThreshold.ToString(CultureInfo.InvariantCulture),
                ["analysisParams.moderateSimilarityThreshold"] = cfg.AnalysisParams.ModerateSimilarityThreshold.ToString(CultureInfo.InvariantCulture),
                ["ruleBonus.allModelsPassBonus"] = cfg.RuleBonus.AllModelsPassBonus.ToString(CultureInfo.InvariantCulture),
                ["ruleBonus.interactionBonus"] = cfg.RuleBonus.InteractionBonus.ToString(CultureInfo.InvariantCulture),
                ["ruleBonus.knownCompoundBonus"] = cfg.RuleBonus.KnownCompoundBonus.ToString(CultureInfo.InvariantCulture),
                ["priorityWeights.dockingWeight"] = cfg.PriorityWeights.DockingWeight.ToString(CultureInfo.InvariantCulture),
                ["priorityWeights.similarityWeight"] = cfg.PriorityWeights.SimilarityWeight.ToString(CultureInfo.InvariantCulture),
                ["priorityWeights.consistencyWeight"] = cfg.PriorityWeights.ConsistencyWeight.ToString(CultureInfo.InvariantCulture),
                ["priorityWeights.ruleBonusWeight"] = cfg.PriorityWeights.RuleBonusWeight.ToString(CultureInfo.InvariantCulture),
                ["plotParams.scatterSizeBase"] = cfg.PlotParams.ScatterSizeBase.ToString(CultureInfo.InvariantCulture),
                ["plotParams.scatterSizeScale"] = cfg.PlotParams.ScatterSizeScale.ToString(CultureInfo.InvariantCulture),
            };
}

<div class="jumbotron py-4">
    <h1 class="display-5">@ViewData["Title"]</h1>
    <p class="mb-1">Analytics configuration for this page is independent and <strong>does not affect Spider Plot thresholds</strong>.</p>
    <div class="small text-muted">Applied aggregate method: @Model.Summary.AppliedConfig.AnalysisParams.AggregateMethod, Top N: @Model.Summary.AppliedConfig.AnalysisParams.TopN</div>

    @if (Model.Summary.Validation.Errors.Count > 0)
    {
        <div class="alert alert-danger mt-3 mb-0">
            <strong>Errors:</strong>
            <ul class="mb-0">
                @foreach (var err in Model.Summary.Validation.Errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (Model.Summary.Validation.Warnings.Count > 0)
    {
        <div class="alert alert-warning mt-3 mb-0">
            <strong>Warnings:</strong>
            <ul class="mb-0">
                @foreach (var warning in Model.Summary.Validation.Warnings)
                {
                    <li>@warning</li>
                }
            </ul>
        </div>
    }
</div>

<div class="row mb-3">
    <div class="col-md-3 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">Total rows</div><div class="h4 mb-0">@Model.Summary.TotalRows</div></div></div></div>
    <div class="col-md-3 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">Analyzable rows</div><div class="h4 mb-0">@Model.Summary.AnalyzableRows</div></div></div></div>
    <div class="col-md-3 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">Excluded (docking missing)</div><div class="h4 mb-0">@Model.Summary.ExcludedByMissingDocking</div></div></div></div>
    <div class="col-md-3 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">Excluded (similarity missing)</div><div class="h4 mb-0">@Model.Summary.ExcludedByMissingSimilarity</div></div></div></div>
</div>
<div class="row mb-4">
    <div class="col-md-4 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">Mean docking</div><div class="h4 mb-0">@(Model.Summary.MeanDocking?.ToString("F3", CultureInfo.InvariantCulture) ?? "N/A")</div></div></div></div>
    <div class="col-md-4 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">Median docking</div><div class="h4 mb-0">@(Model.Summary.MedianDocking?.ToString("F3", CultureInfo.InvariantCulture) ?? "N/A")</div></div></div></div>
    <div class="col-md-4 mb-2"><div class="card"><div class="card-body"><div class="text-muted small">High Priority count</div><div class="h4 mb-0">@Model.Summary.HighPriorityCount</div></div></div></div>
</div>

<form method="post" asp-controller="Job" asp-action="Analytics" asp-route-domainId="@Model.DomainId" asp-route-jobId="@Model.Summary.Job.Id" class="card card-body mb-4">
    <div class="row">
        <div class="col-md-2"><label class="small">Top N</label><input class="form-control form-control-sm" type="number" name="analysisParams.topN" min="1" value="@cfg.AnalysisParams.TopN" /></div>
        <div class="col-md-2"><label class="small">Aggregate</label><select class="form-control form-control-sm" name="analysisParams.aggregateMethod"><option selected="@(cfg.AnalysisParams.AggregateMethod=="mean")">mean</option><option selected="@(cfg.AnalysisParams.AggregateMethod=="median")">median</option><option selected="@(cfg.AnalysisParams.AggregateMethod=="min")">min</option></select></div>
        <div class="col-md-2"><label class="small">Docking threshold</label><input class="form-control form-control-sm" type="number" step="0.1" name="platformDefaults.dockingThreshold" value="@cfg.PlatformDefaults.DockingThreshold.ToString(CultureInfo.InvariantCulture)" /></div>
        <div class="col-md-2"><label class="small">Similarity interaction</label><input class="form-control form-control-sm" type="number" step="0.01" name="platformDefaults.similarityThresholdInteraction" value="@cfg.PlatformDefaults.SimilarityThresholdInteraction.ToString(CultureInfo.InvariantCulture)" /></div>
        <div class="col-md-2"><label class="small">Similarity known</label><input class="form-control form-control-sm" type="number" step="0.01" name="platformDefaults.similarityThresholdKnown" value="@cfg.PlatformDefaults.SimilarityThresholdKnown.ToString(CultureInfo.InvariantCulture)" /></div>
        <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary btn-block">Run Analysis</button></div>
    </div>
    @foreach (var kv in routeConfig.Where(k => !new[] { "analysisParams.topN", "analysisParams.aggregateMethod", "platformDefaults.dockingThreshold", "platformDefaults.similarityThresholdInteraction", "platformDefaults.similarityThresholdKnown" }.Contains(k.Key)))
    {
        <input type="hidden" name="@kv.Key" value="@kv.Value" />
    }
</form>

<div class="row mb-3">
    <div class="col-md-6 mb-3"><div class="card"><div class="card-header">Docking distribution</div><div class="card-body"><canvas id="chart-docking"></canvas></div></div></div>
    <div class="col-md-6 mb-3"><div class="card"><div class="card-header">Similarity distribution</div><div class="card-body"><canvas id="chart-similarity"></canvas></div></div></div>
    <div class="col-md-6 mb-3"><div class="card"><div class="card-header">Top candidates bar</div><div class="card-body"><canvas id="chart-top-bar"></canvas></div></div></div>
    <div class="col-md-6 mb-3"><div class="card"><div class="card-header">Model boxplot</div><div class="card-body"><canvas id="chart-boxplot"></canvas></div></div></div>
    <div class="col-md-12 mb-3"><div class="card"><div class="card-header">Priority scatter</div><div class="card-body"><canvas id="chart-priority-scatter"></canvas></div></div></div>
    <div class="col-md-12 mb-3"><div class="card"><div class="card-header">Model correlation heatmap</div><div class="card-body"><div id="chart-heatmap" class="table-responsive"></div></div></div></div>
</div>

<h3>Top N Candidates</h3>
<table class="table table-striped table-hover table-maxwidth mt-3 w-100">
    <thead>
        <tr>
            <th>Protein Symbol</th>
            <th>Gene Symbol</th>
            <th>Docking aggregate</th>
            <th>Docking Std</th>
            <th>Similarity</th>
            <th>Priority Score</th>
            <th>Candidate Class</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var row in Model.Summary.TopCandidates)
        {
            <tr>
                <td>@row.ProteinSymbol</td>
                <td>@row.GeneSymbol</td>
                <td>@(row.DockingEffectiveScore?.ToString("F3", CultureInfo.InvariantCulture) ?? "N/A")</td>
                <td>@(row.DockingStd?.ToString("F3", CultureInfo.InvariantCulture) ?? "N/A")</td>
                <td>@(row.SimilarityScore?.ToString("F3", CultureInfo.InvariantCulture) ?? "N/A")</td>
                <td>@(row.PriorityScore?.ToString("F2", CultureInfo.InvariantCulture) ?? "N/A")</td>
                <td>@row.CandidateClass</td>
            </tr>
        }
    </tbody>
</table>

<div class="row mt-4">
    <div class="col-md-4">
        <h4>Grouped by Protein</h4>
        <table class="table table-sm table-striped">
            <thead><tr><th>Protein</th><th>Rows</th><th>Mean Score</th></tr></thead>
            <tbody>
                @foreach (var group in Model.Summary.GroupedByProtein.Take(10))
                {
                    <tr><td>@group.GroupKey</td><td>@group.AnalyzableRows</td><td>@group.MeanPriorityScore?.ToString("F2", CultureInfo.InvariantCulture)</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-4">
        <h4>Grouped by Gene</h4>
        <table class="table table-sm table-striped">
            <thead><tr><th>Gene</th><th>Rows</th><th>Mean Score</th></tr></thead>
            <tbody>
                @foreach (var group in Model.Summary.GroupedByGene.Take(10))
                {
                    <tr><td>@group.GroupKey</td><td>@group.AnalyzableRows</td><td>@group.MeanPriorityScore?.ToString("F2", CultureInfo.InvariantCulture)</td></tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-4">
        <h4>Grouped by Ligand</h4>
        <table class="table table-sm table-striped">
            <thead><tr><th>Ligand</th><th>Rows</th><th>Mean Score</th></tr></thead>
            <tbody>
                @foreach (var group in Model.Summary.GroupedByLigand.Take(10))
                {
                    <tr><td>@group.GroupKey</td><td>@group.AnalyzableRows</td><td>@group.MeanPriorityScore?.ToString("F2", CultureInfo.InvariantCulture)</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4">
    <a class="btn btn-outline-primary" asp-controller="Job" asp-action="AnalyticsReport" asp-route-domainId="@Model.DomainId" asp-route-jobId="@Model.Summary.Job.Id" asp-all-route-data="routeConfig">Download Analytics Summary CSV <i class="fa fa-download"></i></a>
    <a class="btn btn-outline-primary" asp-controller="Job" asp-action="AnalyticsReportFull" asp-route-domainId="@Model.DomainId" asp-route-jobId="@Model.Summary.Job.Id" asp-all-route-data="routeConfig">Download Full Analysis CSV <i class="fa fa-download"></i></a>
</div>

@section Menu {
    @{
        ViewData["ActiveMenu"] = "docking";
        ViewData["JobNavDomainId"] = Model.DomainId;
        ViewData["JobNavJobId"] = Model.Summary.Job.Id;
        ViewData["JobNavActive"] = "analytics";
    }
    <partial name="_RaWorkspaceMenu" />
    <partial name="_RaJobContextMenu" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        window.jobAnalyticsPayload = @Html.Raw(JsonSerializer.Serialize(Model.FrontendPayload));
        (function () {
            const payload = window.jobAnalyticsPayload || {};
            console.log("Analytics payload", payload);
            console.log("Analytics payload Figures", payload.Figures, payload.figures);

            const fig = payload.Figures || payload.figures || {};
            if (!window.Chart) return;

            const to2 = v => (typeof v === "number" ? v.toFixed(2) : "N/A");
            const classColor = c => c === "High" ? "#d9534f" : c === "Moderate" ? "#f0ad4e" : "#5bc0de";
            const get = (obj, pascal, camel) => obj?.[pascal] ?? obj?.[camel];

            new Chart(document.getElementById("chart-docking"), {
                type: "bar",
                data: {
                    labels: get(get(fig, "DockingDistribution", "dockingDistribution"), "Labels", "labels") || [],
                    datasets: [{
                        label: "Count",
                        data: get(get(fig, "DockingDistribution", "dockingDistribution"), "Counts", "counts") || [],
                        backgroundColor: "#4e79a7"
                    }]
                }
            });

            new Chart(document.getElementById("chart-similarity"), {
                type: "bar",
                data: {
                    labels: get(get(fig, "SimilarityDistribution", "similarityDistribution"), "Labels", "labels") || [],
                    datasets: [{
                        label: "Count",
                        data: get(get(fig, "SimilarityDistribution", "similarityDistribution"), "Counts", "counts") || [],
                        backgroundColor: "#59a14f"
                    }]
                }
            });

            new Chart(document.getElementById("chart-top-bar"), {
                type: "bar",
                data: {
                    labels: get(get(fig, "TopCandidatesBar", "topCandidatesBar"), "Labels", "labels") || [],
                    datasets: [{
                        label: "Priority Score",
                        data: get(get(fig, "TopCandidatesBar", "topCandidatesBar"), "PriorityScores", "priorityScores") || [],
                        backgroundColor: "#9c755f"
                    }]
                },
                options: { indexAxis: 'y' }
            });

            const box = get(get(fig, "ModelBoxplot", "modelBoxplot"), "Models", "models") || [];
            new Chart(document.getElementById("chart-boxplot"), {
                type: "bar",
                data: {
                    labels: box.map(o => o.Model ?? o.model),
                    datasets: [
                        { label: "Q1", data: box.map(o => o.Q1 ?? o.q1), backgroundColor: "#e0ecf8", stack: "s" },
                        { label: "IQR", data: box.map(o => (o.Q3 ?? o.q3) - (o.Q1 ?? o.q1)), backgroundColor: "#4e79a7", stack: "s" }
                    ]
                },
                options: { plugins: { tooltip: { callbacks: { afterBody: (ctx) => { const i = ctx[0].dataIndex; const b = box[i]; return [`min ${to2(b.Min ?? b.min)}`, `median ${to2(b.Median ?? b.median)}`, `max ${to2(b.Max ?? b.max)}`]; } } } } }
            });

            new Chart(document.getElementById("chart-priority-scatter"), {
                type: "bubble",
                data: {
                    datasets: (get(get(fig, "PriorityScatter", "priorityScatter"), "Points", "points") || []).map(p => ({
                        label: p.Label ?? p.label,
                        data: [{ x: p.X ?? p.x, y: p.Y ?? p.y, r: Math.max(3, Math.sqrt(((p.Size ?? p.size) || 1) / 2)) }],
                        backgroundColor: classColor(p.CandidateClass ?? p.candidateClass)
                    }))
                },
                options: { scales: { x: { title: { display: true, text: "Docking (aggregate)" } }, y: { min: 0, max: 1, title: { display: true, text: "Similarity" } } } }
            });

            const heatmapEl = document.getElementById("chart-heatmap");
            const heatmap = get(fig, "ModelCorrelationHeatmap", "modelCorrelationHeatmap") || {};
            const labels = get(heatmap, "Labels", "labels") || [];
            const matrix = get(heatmap, "Matrix", "matrix") || [];
            let html = "<table class='table table-sm table-bordered mb-0'><thead><tr><th></th>" + labels.map(l => `<th>${l}</th>`).join("") + "</tr></thead><tbody>";
            for (let i = 0; i < labels.length; i++) {
                html += `<tr><th>${labels[i]}</th>`;
                for (let j = 0; j < labels.length; j++) {
                    const v = (matrix[i] || [])[j] ?? 0;
                    const red = v > 0 ? Math.round(255 * v) : 0;
                    const blue = v < 0 ? Math.round(255 * -v) : 0;
                    html += `<td style="background-color:rgba(${red},80,${blue},0.28)">${to2(v)}</td>`;
                }
                html += "</tr>";
            }
            heatmapEl.innerHTML = html + "</tbody></table>";
        })();
    </script>
}