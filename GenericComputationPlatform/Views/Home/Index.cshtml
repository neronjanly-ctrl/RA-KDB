@model Domain

@{
    ViewData["Title"] = "Home";
}

@section Menu {
    @{
        ViewData["ActiveMenu"] = "database";
    }
    <partial name="_RaWorkspaceMenu" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/pageIndex.css" asp-append-version="true" />
}

<div class="science-canvas" id="scienceCanvas">
    <div class="science-bg-image"></div>
    <div class="science-overlay-focus"></div>

    <div class="science-bg-layer">
        <canvas id="scienceBgCanvas" class="science-bg-canvas"></canvas>
    </div>

    <div class="science-copy" id="scienceCopy">
        <div class="science-kicker">RA Workspace</div>
        <h1 class="science-title">
            Core Feature Cards
        </h1>
        <div class="science-subtitle">
            Explore two simplified product cards with clean biological visuals,
            information blocks, and lightweight interaction.
        </div>
    </div>

    <section class="science-field" aria-label="Scientific interaction field">
        <div class="science-center">

            <!-- Protein card -->
            <button type="button"
                    class="science-module science-module-protein"
                    id="proteinModule"
                    data-target-url="@Url.Action("Targets", "Home", new { domainId = Model.Id, tagId = "" })"
                    aria-label="Enter Protein KnowledgeBase">
                <div class="feature-card">
                    <div class="feature-card-visual">
                        <div class="protein-cartoon protein-ribbon-cartoon" id="proteinArt">
                            <div class="protein-ribbon helix helix-1"></div>
                            <div class="protein-ribbon helix helix-2"></div>
                            <div class="protein-ribbon helix helix-3"></div>

                            <div class="protein-sheet sheet-1"></div>
                            <div class="protein-sheet sheet-2"></div>

                            <div class="protein-loop loop-1"></div>
                            <div class="protein-loop loop-2"></div>
                            <div class="protein-loop loop-3"></div>

                            <div class="protein-node node-1"></div>
                            <div class="protein-node node-2"></div>
                            <div class="protein-node node-3"></div>

                            <div class="protein-halo halo-1"></div>
                            <div class="protein-halo halo-2"></div>
                        </div>

                        <div class="mascot-layer mascot-layer-protein" aria-hidden="true">
                            <div class="mascot-shadow"></div>

                            <div class="mascot-body">
                                <div class="mascot-body-spot spot-1"></div>
                                <div class="mascot-body-spot spot-2"></div>
                                <div class="mascot-body-spot spot-3"></div>
                                <div class="mascot-ear ear-left"></div>
                                <div class="mascot-ear ear-right"></div>
                                <div class="mascot-leg leg-left"></div>
                                <div class="mascot-leg leg-right"></div>
                            </div>

                            <div class="mascot-head">
                                <div class="mascot-head-core">
                                    <div class="mascot-face-spot face-spot-top"></div>
                                    <div class="mascot-face-spot face-spot-side"></div>
                                    <div class="mascot-cheek cheek-left"></div>
                                    <div class="mascot-cheek cheek-right"></div>
                                    <div class="mascot-snout"></div>
                                    <div class="mascot-mouth"></div>
                                </div>

                                <div class="mascot-horn horn-left"></div>
                                <div class="mascot-horn horn-right"></div>
                                <div class="mascot-brow brow-left"></div>
                                <div class="mascot-brow brow-right"></div>

                                <div class="mascot-eye eye-left">
                                    <div class="mascot-pupil"></div>
                                </div>
                                <div class="mascot-eye eye-right">
                                    <div class="mascot-pupil"></div>
                                </div>
                            </div>

                            <div class="mascot-aura"></div>
                        </div>
                    </div>

                    <div class="feature-card-info">
                        <div class="feature-card-topline">
                            <div>
                                <div class="feature-card-title">Protein KnowledgeBase</div>
                            </div>
                            <div class="feature-card-badge">HUMAN RELATED</div>
                        </div>

                        <div class="feature-card-desc">
                            Explore curated human proteins associated with RA, selected through 
                            a 3-round screening workflow.
                        </div>

                        <div class="feature-card-tags">
                            <span class="feature-tag">RA-Associated Targets</span>
                            <span class="feature-tag">Card & List Browse</span>
                        </div>

                        <div class="feature-metrics">
                            <div class="feature-metric">
                                <div class="feature-metric-label">Focus</div>
                                <div class="feature-metric-value">RA Protein Set</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">Basis</div>
                                <div class="feature-metric-value">Drug + Gene Evidence</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">Curation</div>
                                <div class="feature-metric-value">Manually Curated</div>
                            </div>
                        </div>
                    </div>
                </div>
            </button>

            <!-- Docking card -->
            <button type="button"
                    class="science-module science-module-docking"
                    id="dockingModule"
                    data-target-url="@Url.Action("New", "Job", new { domainId = Model.Id })"
                    aria-label="Enter Docking Computation">
                <div class="feature-card">
                    <div class="feature-card-visual">
                        <div class="docking-cartoon docking-pocket-scene" id="dockingArt">
                            <div class="dock-receptor">
                                <div class="dock-ribbon ribbon-1"></div>
                                <div class="dock-ribbon ribbon-2"></div>
                                <div class="dock-ribbon ribbon-3"></div>
                                <div class="dock-ribbon ribbon-4"></div>

                                <div class="dock-loop dloop-1"></div>
                                <div class="dock-loop dloop-2"></div>
                            </div>

                            <div class="dock-pocket-core"></div>
                            <div class="dock-pocket-ring ring-1"></div>
                            <div class="dock-pocket-ring ring-2"></div>
                            <div class="dock-pocket-hotspot hotspot-1"></div>
                            <div class="dock-pocket-hotspot hotspot-2"></div>

                            <div class="dock-ligand">
                                <div class="ligand-node ln-1"></div>
                                <div class="ligand-node ln-2"></div>
                                <div class="ligand-node ln-3"></div>
                                <div class="ligand-bond lb-1"></div>
                                <div class="ligand-bond lb-2"></div>
                            </div>

                            <div class="dock-guide guide-1"></div>
                            <div class="dock-guide guide-2"></div>
                        </div>

                        <div class="mascot-layer mascot-layer-docking" aria-hidden="true">
                            <div class="mascot-shadow"></div>

                            <div class="mascot-body">
                                <div class="mascot-body-spot spot-1"></div>
                                <div class="mascot-body-spot spot-2"></div>
                                <div class="mascot-body-spot spot-3"></div>
                                <div class="mascot-ear ear-left"></div>
                                <div class="mascot-ear ear-right"></div>
                                <div class="mascot-leg leg-left"></div>
                                <div class="mascot-leg leg-right"></div>
                            </div>

                            <div class="mascot-head">
                                <div class="mascot-head-core">
                                    <div class="mascot-face-spot face-spot-top"></div>
                                    <div class="mascot-face-spot face-spot-side"></div>
                                    <div class="mascot-cheek cheek-left"></div>
                                    <div class="mascot-cheek cheek-right"></div>
                                    <div class="mascot-snout"></div>
                                    <div class="mascot-mouth"></div>
                                </div>

                                <div class="mascot-horn horn-left"></div>
                                <div class="mascot-horn horn-right"></div>
                                <div class="mascot-brow brow-left"></div>
                                <div class="mascot-brow brow-right"></div>

                                <div class="mascot-eye eye-left">
                                    <div class="mascot-pupil"></div>
                                </div>
                                <div class="mascot-eye eye-right">
                                    <div class="mascot-pupil"></div>
                                </div>
                            </div>

                            <div class="mascot-aura"></div>
                        </div>
                    </div>

                    <div class="feature-card-info">
                        <div class="feature-card-topline">
                            <div>
                                <div class="feature-card-title">Protein–Ligand Docking Analysis</div>
                            </div>
                            <div class="feature-card-badge badge-purple">Spider Plot View</div>
                        </div>

                        <div class="feature-card-desc">
                            Visualize docking scores for the selected SMILES against the target protein using Spider Plot.
                        </div>

                        <div class="feature-card-tags">
                            <span class="feature-tag">SMILES</span>
                            <span class="feature-tag">Target Protein</span>
                            <span class="feature-tag">Docking Scores</span>
                        </div>

                        <div class="feature-metrics">
                            <div class="feature-metric">
                                <div class="feature-metric-label">Binding Site</div>
                                <div class="feature-metric-value">Most Stable Pose</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">Accessibility</div>
                                <div class="feature-metric-value">Guest Access Supported</div>
                            </div>
                        </div>
                    </div>
                </div>
            </button>

        </div>
    </section>

    <div class="science-hint" id="scienceHint">
        Hover card to activate
    </div>
</div>

@section Scripts {
    <script src="~/js/pageIndex.js" asp-append-version="true"></script>
}