@model Domain

@{
    ViewData["Title"] = "Home";
}

@section Menu {
    @{
        ViewData["ActiveMenu"] = "database";
    }
    <partial name="_RaWorkspaceMenu" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/pageIndex.css" asp-append-version="true" />
}

<div class="science-canvas" id="scienceCanvas">
    <div class="science-bg-image"></div>
    <div class="science-overlay-focus"></div>

    <div class="science-bg-layer">
        <canvas id="scienceBgCanvas" class="science-bg-canvas"></canvas>
    </div>

    <div class="science-copy" id="scienceCopy">
        <div class="science-kicker">Scientific Workspace</div>
        <h1 class="science-title">
            Core Feature Cards
        </h1>
        <div class="science-subtitle">
            Explore two simplified product cards with clean biological visuals,
            information blocks, and lightweight interaction.
        </div>
    </div>

    <section class="science-field" aria-label="Scientific interaction field">
        <div class="science-center">

            <!-- Protein card -->
            <button type="button"
                    class="science-module science-module-protein"
                    id="proteinModule"
                    data-target-url="@Url.Action("Targets", "Home", new { domainId = Model.Id, tagId = "" })"
                    aria-label="Enter Protein KnowledgeBase">
                <div class="feature-card">
                    <div class="feature-card-visual">
                        <div class="protein-cartoon" id="proteinArt">
                            <div class="protein-capsule capsule-1"></div>
                            <div class="protein-capsule capsule-2"></div>
                            <div class="protein-capsule capsule-3"></div>
                            <div class="protein-capsule capsule-4"></div>

                            <div class="protein-arm"></div>
                            <div class="protein-base protein-base-1"></div>
                            <div class="protein-base protein-base-2"></div>

                            <div class="protein-connector connector-1"></div>
                            <div class="protein-connector connector-2"></div>
                            <div class="protein-connector connector-3"></div>

                            <div class="protein-glow glow-1"></div>
                            <div class="protein-glow glow-2"></div>
                        </div>
                    </div>

                    <div class="feature-card-info">
                        <div class="feature-card-topline">
                            <div>
                                <div class="feature-card-title">Protein KnowledgeBase</div>
                                <div class="feature-card-subtitle">Knowledge Core / Structured View</div>
                            </div>
                            <div class="feature-card-badge">ACTIVE</div>
                        </div>

                        <div class="feature-card-desc">
                            A simplified modular protein card with a white-top visual area,
                            clean biological silhouettes, and concise information layout.
                        </div>

                        <div class="feature-card-tags">
                            <span class="feature-tag">Protein</span>
                            <span class="feature-tag">Cartoon Module</span>
                            <span class="feature-tag">Knowledge UI</span>
                        </div>

                        <div class="feature-metrics">
                            <div class="feature-metric">
                                <div class="feature-metric-label">Coverage</div>
                                <div class="feature-metric-value">92%</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">Status</div>
                                <div class="feature-metric-value">Ready</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">Mode</div>
                                <div class="feature-metric-value">Browse</div>
                            </div>
                        </div>
                    </div>
                </div>
            </button>

            <!-- Docking card -->
            <button type="button"
                    class="science-module science-module-docking"
                    id="dockingModule"
                    data-target-url="@Url.Action("New", "Job", new { domainId = Model.Id })"
                    aria-label="Enter Docking Computation">
                <div class="feature-card">
                    <div class="feature-card-visual">
                        <div class="docking-cartoon" id="dockingArt">
                            <div class="dock-protein-block block-1"></div>
                            <div class="dock-protein-block block-2"></div>
                            <div class="dock-protein-block block-3"></div>
                            <div class="dock-protein-block block-4"></div>

                            <div class="dock-pocket"></div>
                            <div class="dock-pocket-ring"></div>

                            <div class="dock-ligand-body"></div>
                            <div class="dock-ligand-head"></div>
                            <div class="dock-ligand-tail"></div>

                            <div class="dock-link link-1"></div>
                            <div class="dock-link link-2"></div>

                            <div class="dock-spark spark-1"></div>
                            <div class="dock-spark spark-2"></div>
                        </div>
                    </div>

                    <div class="feature-card-info">
                        <div class="feature-card-topline">
                            <div>
                                <div class="feature-card-title">Docking Computation</div>
                                <div class="feature-card-subtitle">Binding Solver / Visual Card</div>
                            </div>
                            <div class="feature-card-badge badge-purple">LIVE</div>
                        </div>

                        <div class="feature-card-desc">
                            A simplified docking card showing a clean protein pocket,
                            ligand approach, and restrained interface glow in product style.
                        </div>

                        <div class="feature-card-tags">
                            <span class="feature-tag">Docking</span>
                            <span class="feature-tag">Ligand</span>
                            <span class="feature-tag">Computation</span>
                        </div>

                        <div class="feature-metrics">
                            <div class="feature-metric">
                                <div class="feature-metric-label">Binding</div>
                                <div class="feature-metric-value">Stable</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">Queue</div>
                                <div class="feature-metric-value">Open</div>
                            </div>
                            <div class="feature-metric">
                                <div class="feature-metric-label">State</div>
                                <div class="feature-metric-value">Run</div>
                            </div>
                        </div>
                    </div>
                </div>
            </button>

        </div>
    </section>

    <div class="science-hint" id="scienceHint">
        Hover the cards to activate subtle motion
    </div>
</div>

@section Scripts {
    <script src="~/js/pageIndex.js" asp-append-version="true"></script>
}