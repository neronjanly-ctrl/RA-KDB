@model TargetListModel
@using System.Linq
@using System.Collections.Generic
@using DockingDataModels

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.TagName)
        ? "RA Protein Database"
        : $"RA Protein Database - {Model.TagName}";

    var cavities = Model.Targets
        .SelectMany(o => o.Cavities ?? new List<Cavity>())
        .Where(o => o.Protein != null)
        .OrderBy(o => o.Protein.ProteinName)
        .ThenBy(o => o.BindingSite)
        .ToList();

    var topBanner = Url.Content("~/images/version1/bg_01.png");

    const string allCategoryKey = "all";

    var categoryDefinitions = new[]
    {
        new
        {
            Key = "inflammation-immune",
            Name = "Inflammation & Immune Regulation",
            Description = "Core RA inflammatory amplification, autoimmunity activation, cytokine signaling, and innate immune regulation.",
            Symbols = new HashSet<string>(new[]
            {
                "AHR_HUMAN","BTK_HUMAN","CASP1_HUMAN","CCR5_HUMAN","CXCR1_HUMAN","CXCR4_HUMAN","DRB1_HUMAN","E2AK2_HUMAN","GCR_HUMAN","IKBA_HUMAN","IKKA_HUMAN","IKKB_HUMAN","IL2RB_HUMAN","IL2_HUMAN","IL6_HUMAN","JAK1_HUMAN","JAK2_HUMAN","NFKB1_HUMAN","NOS2_HUMAN","PADI4_HUMAN","RELB_HUMAN","STAT3_HUMAN","SYK_HUMAN","TF65_HUMAN","TLR7_HUMAN","TNFA_HUMAN","TYK2_HUMAN"
            })
        },
        new
        {
            Key = "signal-proliferation",
            Name = "Signal Transduction & Cell Proliferation",
            Description = "Synoviocyte activation, kinase networks, and cell proliferation/migration signaling.",
            Symbols = new HashSet<string>(new[]
            {
                "AKT1_HUMAN","FAK1_HUMAN","FAK2_HUMAN","FOXO3_HUMAN","HCK_HUMAN","HGF_HUMAN","KI20A_HUMAN","MET_HUMAN","MK01_HUMAN","MK14_HUMAN","PLK1_HUMAN","PTEN_HUMAN","PTN1_HUMAN","PTN22_HUMAN","RAF1_HUMAN","SRC_HUMAN"
            })
        },
        new
        {
            Key = "tissue-remodeling",
            Name = "Tissue Destruction & Synovial Remodeling",
            Description = "Synovial invasion, matrix degradation, cytoskeleton remodeling, angiogenesis, and microenvironment changes.",
            Symbols = new HashSet<string>(new[]
            {
                "MMP2_HUMAN","MMP8_HUMAN","MMP9_HUMAN","NOS3_HUMAN","RAC1_HUMAN","RHOA_HUMAN","VGFR2_HUMAN","HMR1_HUMAN","TNAP3_HUMAN"
            })
        },
        new
        {
            Key = "metabolic-supportive",
            Name = "Metabolic & Supportive Regulation",
            Description = "Metabolic regulation, drug response, lipid inflammatory mediators, transport, and supportive control.",
            Symbols = new HashSet<string>(new[]
            {
                "A1AG1_HUMAN","A1AG2_HUMAN","ABCG2_HUMAN","PD2R2_HUMAN","PE2R4_HUMAN","PGH1_HUMAN","PGH2_HUMAN","PPARA_HUMAN","PPARG_HUMAN","PPIA_HUMAN","S19A1_HUMAN","XCT_HUMAN"
            })
        }
    };

    string ResolveCategoryKey(string proteinSymbol)
    {
        if (string.IsNullOrWhiteSpace(proteinSymbol)) return "other";
        var normalized = proteinSymbol.Trim().ToUpperInvariant();
        return categoryDefinitions.FirstOrDefault(def => def.Symbols.Contains(normalized))?.Key ?? "other";
    }

    string ResolveCategoryName(string categoryKey)
    {
        if (categoryKey == "other") return "Other / Unclassified";
        return categoryDefinitions.FirstOrDefault(def => def.Key == categoryKey)?.Name ?? "Other / Unclassified";
    }

    var cavityItems = cavities.Select(cavity =>
    {
        var protein = cavity.Protein;
        var proteinTags = protein.Tags ?? new List<ProteinTag>();
        var cavityId = cavity.Id.StringifyId();
        var imagePath = $"~/images/s/{cavity.ProteinId}-{cavity.BindingSite}-model_1.png";
        var categoryKey = ResolveCategoryKey($"{protein.ProteinSymbol}_{protein.OrganismSymbol}");

        var searchText = string.Join(" ",
            new[]
            {
                protein.ProteinName,
                protein.GeneSymbol,
                protein.ProteinSymbol,
                protein.Properties?.UniProt?.Id,
                string.Join(" ", proteinTags.Select(t => t.Name))
            }.Where(x => !string.IsNullOrWhiteSpace(x))
        );

        return new
        {
            CavityId = cavityId,
            BindingSite = cavity.BindingSite,
            ProteinName = protein.ProteinName,
            GeneSymbol = protein.GeneSymbol,
            ProteinSymbol = protein.ProteinSymbol,
            OrganismSymbol = protein.OrganismSymbol,
            Organism = protein.Organism,
            UniProt = protein.Properties?.UniProt,
            Chembl = protein.Properties?.Chembl,
            CategoryKey = categoryKey,
            CategoryName = ResolveCategoryName(categoryKey),
            SearchText = searchText,
            ImageUrl = Url.Content(imagePath),
            DetailsUrl = Url.Action("Details", "Protein", new { domainId = Model.Domain.Id, cavityId })
        };
    }).ToList();

    var categoryStats = categoryDefinitions
        .Select(def => new
        {
            def.Key,
            def.Name,
            def.Description,
            Count = cavityItems.Count(item => item.CategoryKey == def.Key)
        })
        .Where(x => x.Count > 0)
        .ToList();
}

@section Menu {
    @{
        ViewData["ActiveMenu"] = "database";
    }
    <partial name="_RaWorkspaceMenu" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/pageTargets.css" asp-append-version="true" />
}

<div class="ra-platform-home">
    <section class="ra-overview ra-module ra-module--dark" id="top">
        <div class="ra-banner">
            <img src="@topBanner" alt="RA Protein Database" />
            <div class="ra-banner-overlay"></div>
            <div class="ra-banner-inner ra-container">
                <h1 class="ra-hero-title">Rheumatoid Arthritis Protein Target Database</h1>
                <p class="ra-hero-desc">
                    Explore curated rheumatoid arthritis related targets, protein records, and docking-ready structures
                    in this research workspace designed for efficient browsing, comparison, and computational analysis.
                </p>
            </div>
        </div>
    </section>

    <section class="ra-module ra-module--light" id="search">
        <div class="ra-module-body ra-container">
            <div class="ra-editorial-head mb-5">
                <h2 class="ra-section-title">Search & Filter Targets</h2>
                <p class="ra-section-desc">
                    Browse @cavityItems.Count structured protein records across @categoryStats.Count functional categories.
                    Search by name, gene, UniProt, or tag to quickly find your target.
                </p>
            </div>

            <div class="ra-card-shell ra-toolbar">
                <div class="ra-toolbar-top">
                    <div class="ra-search-wrap">
                        <input id="raSearchInput" class="ra-search" type="text" placeholder="Search by protein name, gene symbol, UniProt ID, or tag..." />
                    </div>
                    <div class="ra-controls">
                        <div class="ra-view-toggle">
                            <button class="ra-toggle-btn" type="button" data-view="card" aria-pressed="false">Card view</button>
                            <button class="ra-toggle-btn is-active" type="button" data-view="table" aria-pressed="true">Table view</button>
                        </div>
                        <div class="ra-page-size">
                            <button class="ra-size-btn is-active" type="button" data-size="20">20</button>
                            <button class="ra-size-btn" type="button" data-size="50">50</button>
                        </div>
                    </div>
                </div>

                <div class="ra-toolbar-bottom">
                    <div class="ra-category-panel" aria-label="Protein functional categories">
                        <div class="ra-category-row ra-category-row--all">
                            <button type="button"
                                    class="ra-category-chip ra-category-chip--all is-active"
                                    data-category="@allCategoryKey"
                                    data-category-name="All categories"
                                    aria-pressed="true">
                                <span class="ra-category-label">All categories</span>
                            </button>
                        </div>

                        @if (categoryStats.Count >= 3)
                        {
                            <div class="ra-category-row ra-category-row--main">
                                @for (var i = 0; i < 3; i++)
                                {
                                    var category = categoryStats[i];
                                    <button type="button"
                                            class="ra-category-chip ra-category-chip--grid"
                                            data-category="@category.Key"
                                            data-category-name="@category.Name"
                                            aria-pressed="false"
                                            title="@category.Description">
                                        <span class="ra-category-label">@category.Name</span>
                                    </button>
                                }
                            </div>
                        }

                        @if (categoryStats.Count > 3)
                        {
                            <div class="ra-category-row ra-category-row--tail">
                                @for (var i = 3; i < categoryStats.Count; i++)
                                {
                                    var category = categoryStats[i];
                                    <button type="button"
                                            class="ra-category-chip ra-category-chip--tail"
                                            data-category="@category.Key"
                                            data-category-name="@category.Name"
                                            aria-pressed="false"
                                            title="@category.Description">
                                        <span class="ra-category-label">@category.Name</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                </div>
            </div>

            <div class="ra-card-shell ra-results mt-4">
                <div id="raCardView" class="ra-card-view"></div>
                <div id="raTableView" class="ra-table-view"></div>

                <div id="raEmptyState" class="ra-empty mt-3" style="display:none;">
                    No targets are available for the current filter.
                </div>

                <div class="ra-pagination">
                    <div class="ra-page-info">
                        Page <span id="raCurrentPage">1</span> / <span id="raTotalPages">1</span>
                    </div>
                    <div class="ra-page-actions">
                        <button class="ra-page-btn" id="raPrevPage" type="button">Previous</button>
                        <button class="ra-page-btn" id="raNextPage" type="button">Next</button>
                    </div>
                </div>

                <div class="ra-footer-actions">
                    <a class="btn-ra-secondary"
                       asp-controller="Home"
                       asp-action="Index"
                       asp-route-domainId="@Model.Domain.Id">
                        Back to RA Workspace
                    </a>
                    <a class="btn-ra-primary"
                       asp-controller="Job"
                       asp-action="New"
                       asp-route-domainId="@Model.Domain.Id">
                        Continue to Docking
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade" id="imagePreviewModal" tabindex="-1" role="dialog" aria-labelledby="imagePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 24px; overflow: hidden;">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewTitle">Preview</h5>
                <button type="button" class="close ml-2" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <img id="imagePreviewTarget" src="" alt="" style="width:100%; border-radius:16px; margin-bottom:1rem; background:#eef3fa;" />
                <div class="ra-modal-meta">
                    <div><strong>Protein:</strong> <span id="imagePreviewProteinName"></span></div>
                    <div><strong>Gene:</strong> <span id="imagePreviewGene"></span></div>
                    <div><strong>Binding site:</strong> <span id="imagePreviewBinding"></span></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const allItems = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(cavityItems));

            const searchInput = document.getElementById("raSearchInput");
            const viewButtons = Array.from(document.querySelectorAll(".ra-view-toggle .ra-toggle-btn"));
            const sizeButtons = Array.from(document.querySelectorAll(".ra-page-size .ra-size-btn"));
            const categoryButtons = Array.from(document.querySelectorAll(".ra-category-chip"));

            const cardView = document.getElementById("raCardView");
            const tableView = document.getElementById("raTableView");
            const emptyState = document.getElementById("raEmptyState");

            const visibleCount = document.getElementById("raVisibleCount");
            const categoryMeta = document.getElementById("raCategoryMeta");
            const currentPageLabel = document.getElementById("raCurrentPage");
            const totalPagesLabel = document.getElementById("raTotalPages");
            const prevPageBtn = document.getElementById("raPrevPage");
            const nextPageBtn = document.getElementById("raNextPage");

            let currentView = "table";
            let pageSize = 20;
            let currentPage = 1;
            let currentCategory = "all";

            function safeText(value) {
                return value ?? "";
            }

            function getFilteredData() {
                const q = (searchInput.value || "").trim().toLowerCase();

                return allItems.filter(item => {
                    const catMatch = currentCategory === "all" || item.CategoryKey === currentCategory;
                    const searchMatch = !q || safeText(item.SearchText).toLowerCase().includes(q);
                    return catMatch && searchMatch;
                });
            }

            function renderCardView(pageItems) {
                cardView.innerHTML = "";

                pageItems.forEach(item => {
                    const html = `
                                <article class="ra-target-card">
                                    <button type="button"
                                            class="ra-target-thumb-btn"
                                            data-toggle="modal"
                                            data-target="#imagePreviewModal"
                                            data-title="${safeText(item.ProteinName)}"
                                            data-subtitle="${safeText(item.GeneSymbol)}"
                                            data-binding="${safeText(item.BindingSite)}"
                                            data-image="${safeText(item.ImageUrl)}">
                                        <img class="ra-target-thumb" src="${safeText(item.ImageUrl)}" alt="${safeText(item.ProteinName)}">
                                    </button>
                                    <div class="ra-target-body">
                                        <div class="ra-target-title">${safeText(item.ProteinName)}</div>
                                        <div class="ra-target-sub"><strong>Gene:</strong> ${safeText(item.GeneSymbol)}</div>
                                        <div class="ra-target-actions">
                                            <a class="btn-ra-primary" href="${safeText(item.DetailsUrl)}">View details</a>
                                        </div>
                                    </div>
                                </article>`;
                    cardView.insertAdjacentHTML("beforeend", html);
                });
            }

            function renderTableView(pageItems) {
                let html = `
                            <div class="ra-table-shell">
                                <table class="ra-table">
                                    <thead>
                                        <tr>
                                            <th>Preview</th>
                                            <th>Protein</th>
                                            <th>Gene / Symbol</th>
                                            <th>Binding Site</th>
                                            <th>Organism</th>
                                            <th>UniProt / ChEMBL</th>
                                            <th>Details</th>
                                        </tr>
                                    </thead>
                                    <tbody>`;

                pageItems.forEach(item => {
                    const uniprot = item.UniProt
                        ? `<a target="_blank" rel="noopener noreferrer" href="${item.UniProt.Url}">${item.UniProt.Id}</a>`
                        : "";

                    const chembl = item.Chembl
                        ? `<a target="_blank" rel="noopener noreferrer" href="${item.Chembl.TargetUrl}">${item.Chembl.Id}</a>`
                        : "";

                    html += `
                                <tr>
                                    <td>
                                        <button type="button"
                                                class="ra-table-thumb-btn"
                                                data-toggle="modal"
                                                data-target="#imagePreviewModal"
                                                data-image="${safeText(item.ImageUrl)}"
                                                data-title="${safeText(item.ProteinName)}"
                                                data-subtitle="${safeText(item.GeneSymbol)}"
                                                data-binding="${safeText(item.BindingSite)}">
                                            <img class="ra-table-thumb" src="${safeText(item.ImageUrl)}" alt="${safeText(item.ProteinName)}">
                                        </button>
                                    </td>
                                    <td><div class="ra-table-name">${safeText(item.ProteinName)}</div></td>
                                    <td><div class="ra-table-name">${safeText(item.GeneSymbol)}</div></td>
                                    <td><div class="ra-table-meta">${safeText(item.BindingSite)}</div></td>
                                    <td><div class="ra-table-meta">${safeText(item.Organism).replace(/;/g, "; ")}</div></td>
                                    <td><div class="ra-ref-links">${uniprot} ${chembl}</div></td>
                                    <td><a class="btn-ra-primary" href="${safeText(item.DetailsUrl)}">Details</a></td>
                                </tr>`;
                });

                html += `
                                    </tbody>
                                </table>
                            </div>`;

                tableView.innerHTML = html;
            }

            function render() {
                const filtered = getFilteredData();
                const total = filtered.length;
                const totalPages = Math.ceil(total / pageSize) || 1;
                currentPage = Math.min(currentPage, totalPages);

                const start = (currentPage - 1) * pageSize;
                const pageItems = filtered.slice(start, start + pageSize);

                cardView.innerHTML = "";
                tableView.innerHTML = "";

                if (currentView === "card") {
                    renderCardView(pageItems);
                } else {
                    renderTableView(pageItems);
                }

                cardView.style.display = currentView === "card" ? "grid" : "none";
                tableView.style.display = currentView === "table" ? "block" : "none";
                emptyState.style.display = total === 0 ? "block" : "none";

                visibleCount.textContent = total;
                currentPageLabel.textContent = currentPage;
                totalPagesLabel.textContent = totalPages;
                prevPageBtn.disabled = currentPage <= 1;
                nextPageBtn.disabled = currentPage >= totalPages;

                const activeCat = document.querySelector(".ra-category-chip.is-active")?.dataset.categoryName;
                categoryMeta.textContent = currentCategory === "all" ? "" : ` • category: ${activeCat}`;
            }

            viewButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    viewButtons.forEach(b => {
                        b.classList.remove("is-active");
                        b.setAttribute("aria-pressed", "false");
                    });
                    btn.classList.add("is-active");
                    btn.setAttribute("aria-pressed", "true");
                    currentView = btn.dataset.view;
                    render();
                });
            });

            sizeButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    sizeButtons.forEach(b => b.classList.remove("is-active"));
                    btn.classList.add("is-active");
                    pageSize = parseInt(btn.dataset.size, 10);
                    currentPage = 1;
                    render();
                });
            });

            categoryButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    categoryButtons.forEach(b => {
                        b.classList.remove("is-active");
                        b.setAttribute("aria-pressed", "false");
                    });
                    btn.classList.add("is-active");
                    btn.setAttribute("aria-pressed", "true");
                    currentCategory = btn.dataset.category;
                    currentPage = 1;
                    render();
                });
            });

            let searchTimer;
            searchInput.addEventListener("input", () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(() => {
                    currentPage = 1;
                    render();
                }, 180);
            });

            prevPageBtn.addEventListener("click", () => {
                if (currentPage > 1) {
                    currentPage--;
                    render();
                }
            });

            nextPageBtn.addEventListener("click", () => {
                const total = parseInt(totalPagesLabel.textContent, 10);
                if (currentPage < total) {
                    currentPage++;
                    render();
                }
            });

            $("#imagePreviewModal").on("show.bs.modal", function (e) {
                const t = $(e.relatedTarget);
                $("#imagePreviewProteinName").text(t.data("title") || "");
                $("#imagePreviewGene").text(t.data("subtitle") || "");
                $("#imagePreviewBinding").text(t.data("binding") || "");
                $("#imagePreviewTarget").attr("src", t.data("image") || "");
            });

            render();
        });
    </script>
}