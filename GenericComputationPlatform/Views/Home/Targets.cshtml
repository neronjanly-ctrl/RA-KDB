@model TargetListModel
@using System.Linq
@using System.Collections.Generic
@using DockingDataModels

@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.TagName)
        ? "RA Protein Database"
        : $"RA Protein Database - {Model.TagName}";

    var cavities = Model.Targets
        .SelectMany(o => o.Cavities ?? new List<Cavity>())
        .Where(o => o.Protein != null)
        .OrderBy(o => o.Protein.ProteinName)
        .ThenBy(o => o.BindingSite)
        .ToList();

    var totalProteins = cavities
        .Select(o => o.ProteinId)
        .Distinct()
        .Count();

    var totalCavities = cavities.Count;

    var overviewBanner = Url.Content("~/images/version1/bg_01.png");

    const int defaultPageSize = 20;
    const string allCategoryKey = "all";

    var categoryDefinitions = new[]
    {
        new
        {
            Key = "inflammation-immune",
            Name = "Inflammation & Immune Regulation",
            Description = "Core RA inflammatory amplification, autoimmunity activation, cytokine signaling, and innate immune regulation.",
            Symbols = new HashSet<string>(new[]
            {
                "AHR_HUMAN","BTK_HUMAN","CASP1_HUMAN","CCR5_HUMAN","CXCR1_HUMAN","CXCR4_HUMAN","DRB1_HUMAN","E2AK2_HUMAN","GCR_HUMAN","IKBA_HUMAN","IKKA_HUMAN","IKKB_HUMAN","IL2RB_HUMAN","IL2_HUMAN","IL6_HUMAN","JAK1_HUMAN","JAK2_HUMAN","NFKB1_HUMAN","NOS2_HUMAN","PADI4_HUMAN","RELB_HUMAN","STAT3_HUMAN","SYK_HUMAN","TF65_HUMAN","TLR7_HUMAN","TNFA_HUMAN","TYK2_HUMAN"
            })
        },
        new
        {
            Key = "signal-proliferation",
            Name = "Signal Transduction & Cell Proliferation",
            Description = "Synoviocyte activation, kinase networks, and cell proliferation/migration signaling.",
            Symbols = new HashSet<string>(new[]
            {
                "AKT1_HUMAN","FAK1_HUMAN","FAK2_HUMAN","FOXO3_HUMAN","HCK_HUMAN","HGF_HUMAN","KI20A_HUMAN","MET_HUMAN","MK01_HUMAN","MK14_HUMAN","PLK1_HUMAN","PTEN_HUMAN","PTN1_HUMAN","PTN22_HUMAN","RAF1_HUMAN","SRC_HUMAN"
            })
        },
        new
        {
            Key = "tissue-remodeling",
            Name = "Tissue Destruction & Synovial Remodeling",
            Description = "Synovial invasion, matrix degradation, cytoskeleton remodeling, angiogenesis, and microenvironment changes.",
            Symbols = new HashSet<string>(new[]
            {
                "MMP2_HUMAN","MMP8_HUMAN","MMP9_HUMAN","NOS3_HUMAN","RAC1_HUMAN","RHOA_HUMAN","VGFR2_HUMAN","HMR1_HUMAN","TNAP3_HUMAN"
            })
        },
        new
        {
            Key = "metabolic-supportive",
            Name = "Metabolic & Supportive Regulation",
            Description = "Metabolic regulation, drug response, lipid inflammatory mediators, transport, and supportive control.",
            Symbols = new HashSet<string>(new[]
            {
                "A1AG1_HUMAN","A1AG2_HUMAN","ABCG2_HUMAN","PD2R2_HUMAN","PE2R4_HUMAN","PGH1_HUMAN","PGH2_HUMAN","PPARA_HUMAN","PPARG_HUMAN","PPIA_HUMAN","S19A1_HUMAN","XCT_HUMAN"
            })
        }
    };

    string ResolveCategoryKey(string proteinSymbol)
    {
        if (string.IsNullOrWhiteSpace(proteinSymbol)) return "other";
        var normalized = proteinSymbol.Trim().ToUpperInvariant();
        return categoryDefinitions.FirstOrDefault(def => def.Symbols.Contains(normalized))?.Key ?? "other";
    }

    string ResolveCategoryName(string categoryKey)
    {
        if (categoryKey == "other") return "Other / Unclassified";
        return categoryDefinitions.FirstOrDefault(def => def.Key == categoryKey)?.Name ?? "Other / Unclassified";
    }

    var cavityItems = cavities.Select(cavity =>
    {
        var protein = cavity.Protein;
        var proteinTags = protein.Tags ?? new List<ProteinTag>();
        var cavityId = cavity.Id.StringifyId();
        var imagePath = $"~/images/s/{cavity.ProteinId}-{cavity.BindingSite}-model_1.png";
        var categoryKey = ResolveCategoryKey($"{protein.ProteinSymbol}_{protein.OrganismSymbol}");

        var searchText = string.Join(" ",
            new[]
            {
                protein.ProteinName,
                protein.GeneSymbol,
                protein.ProteinSymbol,
                protein.Properties?.UniProt?.Id,
                string.Join(" ", proteinTags.Select(t => t.Name))
            }.Where(x => !string.IsNullOrWhiteSpace(x))
        );

        return new
        {
            Cavity = cavity,
            Protein = protein,
            CavityId = cavityId,
            CategoryKey = categoryKey,
            CategoryName = ResolveCategoryName(categoryKey),
            SearchText = searchText,
            ImageUrl = Url.Content(imagePath),
            DetailsUrl = Url.Action("Details", "Protein", new { domainId = Model.Domain.Id, cavityId })
        };
    }).ToList();

    var categoryStats = categoryDefinitions
        .Select(def => new
        {
            def.Key,
            def.Name,
            def.Description,
            Count = cavityItems.Count(item => item.CategoryKey == def.Key)
        })
        .Where(x => x.Count > 0)
        .ToList();
}

@section Menu {
    @{
        ViewData["ActiveMenu"] = "database";
    }
    <partial name="_RaWorkspaceMenu" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/pageTargets.css" asp-append-version="true" />
}

<div class="ra-db-page">
    <!-- Header -->
    <section class="ra-section ra-header-hero">
        <div class="ra-hero-banner">
            <img class="ra-hero-banner-image"
                 src="@overviewBanner"
                 alt="Rheumatoid arthritis protein research database" />

            <div class="ra-hero-banner-overlay"></div>

            <div class="ra-hero-banner-inner">
                <div class="ra-hero-copy">
                    <div class="ra-hero-kicker">Curated RA protein database</div>

                    <h1 class="ra-hero-title">
                        Rheumatoid Arthritis Protein Target Database
                    </h1>

                    <p class="ra-hero-desc">
                        Explore curated rheumatoid arthritis related targets, protein records, and docking-ready
                        structures in this research workspace designed for efficient browsing, comparison,
                        and downstream computational analysis.
                    </p>

                    <div class="ra-hero-meta">
                        <div class="ra-hero-meta-item">
                            <span class="ra-hero-meta-value">@totalProteins</span>
                            <span class="ra-hero-meta-label">Proteins</span>
                        </div>

                        <div class="ra-hero-meta-item">
                            <span class="ra-hero-meta-value">@totalCavities</span>
                            <span class="ra-hero-meta-label">Cavities</span>
                        </div>

                        <div class="ra-hero-meta-item">
                            <span class="ra-hero-meta-value">Data sources :</span>
                            <span class="ra-hero-meta-label">Paper and Drug</span>
                        </div>

                        <div class="ra-result-meta">
                            <span id="raVisibleCount">@cavityItems.Count</span> visible records
                            <span id="raCategoryMeta"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Toolbar -->
    <section class="ra-section ra-card-shell ra-toolbar">
        <div class="ra-toolbar-top">
            <div class="ra-search-wrap">
                <input id="raSearchInput"
                       class="ra-search"
                       type="text"
                       placeholder="Search by protein name, gene symbol, UniProt ID, or tag..." />
            </div>

            <div class="ra-controls">
                <div class="ra-view-toggle">
                    <button class="ra-toggle-btn is-active" type="button" data-view="card" aria-pressed="true">Card view</button>
                    <button class="ra-toggle-btn" type="button" data-view="table" aria-pressed="false">Table view</button>
                </div>

                <div class="ra-page-size">
                    <button class="ra-size-btn is-active" type="button" data-size="20">20</button>
                    <button class="ra-size-btn" type="button" data-size="50">50</button>
                </div>
            </div>
        </div>
        <div class="ra-toolbar-bottom">
            <div class="ra-category-panel" aria-label="Protein functional categories">
                <div class="ra-category-row ra-category-row--all">
                    <button type="button"
                            class="ra-category-chip ra-category-chip--all is-active"
                            data-category="@allCategoryKey"
                            data-category-name="All categories"
                            aria-pressed="true">
                        <span class="ra-category-label">All categories</span>
                        <span class="ra-category-count">@cavityItems.Count</span>
                    </button>
                </div>

                @if (categoryStats.Count >= 3)
                {
                    <div class="ra-category-row ra-category-row--main">
                        @for (var i = 0; i < 3; i++)
                        {
                            var category = categoryStats[i];
                            <button type="button"
                                    class="ra-category-chip ra-category-chip--grid"
                                    data-category="@category.Key"
                                    data-category-name="@category.Name"
                                    aria-pressed="false"
                                    title="@category.Description">
                                <span class="ra-category-label">@category.Name</span>
                                <span class="ra-category-count">@category.Count</span>
                            </button>
                        }
                    </div>
                }

                @if (categoryStats.Count > 3)
                {
                    <div class="ra-category-row ra-category-row--tail">
                        @for (var i = 3; i < categoryStats.Count; i++)
                        {
                            var category = categoryStats[i];
                            <button type="button"
                                    class="ra-category-chip ra-category-chip--tail"
                                    data-category="@category.Key"
                                    data-category-name="@category.Name"
                                    aria-pressed="false"
                                    title="@category.Description">
                                <span class="ra-category-label">@category.Name</span>
                                <span class="ra-category-count">@category.Count</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="ra-result-meta">
                <span id="raVisibleCount">@cavityItems.Count</span> visible records
                <span id="raCategoryMeta"></span>
            </div>
        </div>
       
    </section>

    <!-- Results -->
    <section class="ra-section ra-card-shell ra-results">
        <!-- Card view -->
        <div id="raCardView" class="ra-card-view">
            @foreach (var item in cavityItems)
            {
                <article class="ra-target-card ra-result-item"
                         data-kind="card"
                         data-key="@item.CavityId"
                         data-category="@item.CategoryKey"
                         data-search="@item.SearchText">

                    <button type="button"
                            class="ra-target-thumb-btn"
                            data-toggle="modal"
                            data-target="#imagePreviewModal"
                            data-title="@item.Protein.ProteinName"
                            data-subtitle="@item.Protein.GeneSymbol"
                            data-binding="@item.Cavity.BindingSite"
                            data-image="@item.ImageUrl">
                        <img class="ra-target-thumb"
                             src="@item.ImageUrl"
                             alt="@item.Protein.ProteinName" />
                    </button>

                    <div class="ra-target-body">
                        <div class="ra-category-badge">@item.CategoryName</div>

                        <div class="ra-target-title">
                            @item.Protein.ProteinName
                        </div>

                        <div class="ra-target-sub">
                            <div><strong>Gene:</strong> @item.Protein.GeneSymbol</div>
                        </div>

                        <div class="ra-target-actions">
                            <a class="btn-ra-primary"
                               href="@item.DetailsUrl">
                                View details
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Table view -->
        <div id="raTableView" class="ra-table-view">
            <div class="ra-table-shell">
                <table class="ra-table">
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Protein</th>
                            <th>Gene / Symbol</th>
                            <th>Organism</th>
                            <th>UniProt / ChEMBL</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in cavityItems)
                        {
                            <tr class="ra-result-item"
                                data-kind="table"
                                data-key="@item.CavityId"
                                data-category="@item.CategoryKey"
                                data-search="@item.SearchText">

                                <td>
                                    <button type="button"
                                            class="ra-table-thumb-btn"
                                            data-toggle="modal"
                                            data-target="#imagePreviewModal"
                                            data-title="@item.Protein.ProteinName"
                                            data-subtitle="@item.Protein.GeneSymbol"
                                            data-binding="@item.Cavity.BindingSite"
                                            data-image="@item.ImageUrl">
                                        <img class="ra-table-thumb"
                                             src="@item.ImageUrl"
                                             alt="@item.Protein.ProteinName" />
                                    </button>
                                </td>

                                <td>
                                    <div class="ra-table-name">
                                        @item.Protein.ProteinName
                                    </div>
                                </td>

                                <td>
                                    <div class="ra-table-name">@item.Protein.GeneSymbol</div>
                                    <div class="ra-table-meta">@item.CategoryName</div>
                                    <div class="ra-table-meta">@(item.Protein.ProteinSymbol)_@(item.Protein.OrganismSymbol)</div>
                                </td>

                                <td>
                                    <div class="ra-table-meta">
                                        @item.Protein.Organism?.Replace(";", "; ")
                                    </div>
                                </td>

                                <td>
                                    <div class="ra-ref-links">
                                        @if (item.Protein.Properties?.UniProt != null)
                                        {
                                            <a target="_blank" href="@item.Protein.Properties.UniProt.Url">
                                                @item.Protein.Properties.UniProt.Id
                                            </a>
                                        }
                                        @if (item.Protein.Properties?.Chembl != null)
                                        {
                                            <a target="_blank" href="@item.Protein.Properties.Chembl.TargetUrl">
                                                @item.Protein.Properties.Chembl.Id
                                            </a>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <a class="btn-ra-primary"
                                       href="@item.DetailsUrl">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (!cavityItems.Any())
        {
            <div class="ra-empty mt-3">
                No targets are available for the current filter.
            </div>
        }

        <div class="ra-pagination">
            <div class="ra-page-info">
                Page <span id="raCurrentPage">1</span> / <span id="raTotalPages">1</span>
            </div>

            <div class="ra-page-actions">
                <button class="ra-page-btn" id="raPrevPage" type="button">Previous</button>
                <button class="ra-page-btn" id="raNextPage" type="button">Next</button>
            </div>
        </div>

        <div class="ra-footer-actions">
            <a class="btn-ra-secondary"
               asp-controller="Home"
               asp-action="Index"
               asp-route-domainId="@Model.Domain.Id">
                Back to RA Workspace
            </a>

            <a class="btn-ra-primary"
               asp-controller="Job"
               asp-action="New"
               asp-route-domainId="@Model.Domain.Id">
                Continue to Docking
            </a>
        </div>
    </section>
</div>

<!-- Image preview modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1" role="dialog" aria-labelledby="imagePreviewTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 24px; overflow:hidden;">
            <div class="modal-header">
                <h5 class="modal-title" id="imagePreviewTitle">Preview</h5>
                <button type="button" class="close ml-2" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                <img id="imagePreviewTarget"
                     src=""
                     alt=""
                     style="width:100%; border-radius:16px; margin-bottom:1rem; background:#eef3fa;" />

                <div class="ra-modal-meta">
                    <div><strong>Protein:</strong> <span id="imagePreviewProteinName"></span></div>
                    <div><strong>Gene:</strong> <span id="imagePreviewGene"></span></div>
                    <div><strong>Binding site:</strong> <span id="imagePreviewBinding"></span></div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("raSearchInput");
            const viewButtons = Array.from(document.querySelectorAll(".ra-view-toggle .ra-toggle-btn"));
            const sizeButtons = Array.from(document.querySelectorAll(".ra-page-size .ra-size-btn"));
            const categoryButtons = Array.from(document.querySelectorAll(".ra-category-chip"));

            const cardView = document.getElementById("raCardView");
            const tableView = document.getElementById("raTableView");

            const visibleCount = document.getElementById("raVisibleCount");
            const categoryMeta = document.getElementById("raCategoryMeta");
            const currentPageLabel = document.getElementById("raCurrentPage");
            const totalPagesLabel = document.getElementById("raTotalPages");
            const prevPageBtn = document.getElementById("raPrevPage");
            const nextPageBtn = document.getElementById("raNextPage");

            const allCardItems = Array.from(document.querySelectorAll('.ra-result-item[data-kind="card"]'));
            const allTableItems = Array.from(document.querySelectorAll('.ra-result-item[data-kind="table"]'));

            let currentView = "card";
            let pageSize = @defaultPageSize;
            let currentPage = 1;
            let currentCategory = "@allCategoryKey";

            function filteredItems(kind) {
                const query = (searchInput.value || "").trim().toLowerCase();
                const source = kind === "card" ? allCardItems : allTableItems;

                return source.filter(item => {
                    const text = (item.dataset.search || "").toLowerCase();
                    const category = item.dataset.category || "other";
                    const categoryMatched = currentCategory === "@allCategoryKey" || category === currentCategory;
                    return categoryMatched && (!query || text.includes(query));
                });
            }

            function applyPagination() {
                const filteredCardItems = filteredItems("card");
                const total = filteredCardItems.length;

                const totalPages = Math.max(1, Math.ceil(total / pageSize));
                if (currentPage > totalPages) currentPage = totalPages;

                const start = (currentPage - 1) * pageSize;
                const end = start + pageSize;

                const visibleKeys = new Set(filteredCardItems.slice(start, end).map(x => x.dataset.key));

                allCardItems.forEach(item => {
                    const shouldShow = visibleKeys.has(item.dataset.key) && currentView === "card";
                    item.style.display = shouldShow ? "" : "none";
                });

                allTableItems.forEach(item => {
                    const shouldShow = visibleKeys.has(item.dataset.key) && currentView === "table";
                    item.style.display = shouldShow ? "table-row" : "none";
                });

                cardView.style.display = currentView === "card" ? "grid" : "none";
                tableView.style.display = currentView === "table" ? "block" : "none";

                visibleCount.textContent = total.toString();

                const activeCategoryLabel = categoryButtons.find(btn => btn.classList.contains("is-active"))?.getAttribute("data-category-name");
                categoryMeta.textContent = currentCategory === "@allCategoryKey"
                    ? ""
                    : ` • category: ${activeCategoryLabel || currentCategory}`;

                currentPageLabel.textContent = currentPage.toString();
                totalPagesLabel.textContent = totalPages.toString();

                prevPageBtn.disabled = currentPage <= 1;
                nextPageBtn.disabled = currentPage >= totalPages;
            }

            viewButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    viewButtons.forEach(x => {
                        x.classList.remove("is-active");
                        x.setAttribute("aria-pressed", "false");
                    });

                    this.classList.add("is-active");
                    this.setAttribute("aria-pressed", "true");
                    currentView = this.getAttribute("data-view") || "card";
                    applyPagination();
                });
            });

            sizeButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    sizeButtons.forEach(x => x.classList.remove("is-active"));
                    this.classList.add("is-active");
                    pageSize = parseInt(this.getAttribute("data-size") || "20", 10);
                    currentPage = 1;
                    applyPagination();
                });
            });

            categoryButtons.forEach(btn => {
                btn.addEventListener("click", function () {
                    categoryButtons.forEach(x => {
                        x.classList.remove("is-active");
                        x.setAttribute("aria-pressed", "false");
                    });

                    this.classList.add("is-active");
                    this.setAttribute("aria-pressed", "true");
                    currentCategory = this.getAttribute("data-category") || "@allCategoryKey";
                    currentPage = 1;
                    applyPagination();
                });
            });

            let searchDebounceTimer;
            searchInput.addEventListener("input", function () {
                clearTimeout(searchDebounceTimer);
                searchDebounceTimer = setTimeout(function () {
                    currentPage = 1;
                    applyPagination();
                }, 180);
            });

            prevPageBtn.addEventListener("click", function () {
                if (currentPage > 1) {
                    currentPage--;
                    applyPagination();
                }
            });

            nextPageBtn.addEventListener("click", function () {
                const totalPages = parseInt(totalPagesLabel.textContent || "1", 10);
                if (currentPage < totalPages) {
                    currentPage++;
                    applyPagination();
                }
            });

            $('#imagePreviewModal').on('show.bs.modal', function (event) {
                const trigger = $(event.relatedTarget);
                const title = trigger.data('title') || 'Preview';
                const subtitle = trigger.data('subtitle') || '';
                const binding = trigger.data('binding') || '';
                const image = trigger.data('image') || '';

                $('#imagePreviewTitle').text(title);
                $('#imagePreviewTarget').attr('src', image).attr('alt', title);
                $('#imagePreviewProteinName').text(title);
                $('#imagePreviewGene').text(subtitle);
                $('#imagePreviewBinding').text(binding);
            });

            applyPagination();
        });
    </script>
}